# Public hostname only, without https:// or a trailing slash.
DOMAIN=example.com
PORTFOLIO_PORT=3100

# Server-only Gemini credentials. Never prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=
PORTFOLIO_AI_MODEL=gemini-3.6-flash
PORTFOLIO_AI_PROVIDER_TIMEOUT_MS=25000

# Optional fallback provider. Leave disabled unless it is already deployed.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto:fast
PORTFOLIO_AI_FALLBACK_TIMEOUT_MS=10000
